[Unit]
Description=Upgrade Chamber API scaffold
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=upgrade-chamber
Group=upgrade-chamber
WorkingDirectory=/opt/upgrade-chamber
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/upgrade-chamber/api.env
ExecStart=/opt/upgrade-chamber/.venv/bin/uvicorn upgrade_chamber.api:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3s
# Group-writable so the worker service shares this state directory and its
# SQLite database through the upgrade-chamber group.
UMask=0007
StateDirectory=upgrade-chamber
StateDirectoryMode=0770
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/upgrade-chamber

[Install]
WantedBy=multi-user.target
