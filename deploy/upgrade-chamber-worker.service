[Unit]
Description=Upgrade Chamber worker
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=upgrade-chamber-worker
Group=upgrade-chamber
SupplementaryGroups=docker
WorkingDirectory=/opt/upgrade-chamber
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/upgrade-chamber/worker.env
ExecStart=/opt/upgrade-chamber/.venv/bin/python -m upgrade_chamber.worker
Restart=on-failure
RestartSec=3s
UMask=0007
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/upgrade-chamber

[Install]
WantedBy=multi-user.target
